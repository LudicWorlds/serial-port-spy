<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ApplicationIcon>Assets\serial-port-spy.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <!--
      Transitive dep of ScottPlot.WPF, promoted only to silence NU1701. The
      3.119 package ships assets for net462 and net(6/8).0-windows10.0.19041,
      but nothing our windows7.0 platform floor can use - so NuGet falls back
      to the net462 asset and warns. That fallback is the standard ScottPlot-
      on-WPF configuration (plain WPF interop, no Framework-only API) and is
      verified working here. Retargeting the app to windows10.0.19041 would
      cure the warning at the root, but bolts ~25MB of WinRT projection DLLs
      onto the output of an app that calls no WinRT. Drop this reference when
      ScottPlot moves to a SkiaSharp whose WPF package has a plain -windows
      asset.
    -->
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.0" NoWarn="NU1701" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>
  <!--
    The app icon is embedded into the .exe via <ApplicationIcon> above and is not
    loaded from disk at runtime, so it does not need to be copied to the output.
  -->
</Project>