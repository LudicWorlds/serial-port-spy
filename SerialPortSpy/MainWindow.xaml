<Window x:Class="SerialPortSpy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="800" Height="586" MinWidth="760" MinHeight="440"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <!-- An implicit Window style would not apply here (implicit style lookup
         keys on the runtime type MainWindow), so brand properties are set
         directly on the element above. -->
    <Window.InputBindings>
        <!-- Ctrl+K is the Arduino IDE's own Clear shortcut, so it is already in
             muscle memory for this app's user. Nothing in a read-only
             RichTextBox claims it, so the log keeps its own Ctrl+C / Ctrl+A.
             This resolves because the constructor assigns DataContext before
             InitializeComponent(). -->
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding ClearOutputCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <!-- A COM port as "COM3  USB-SERIAL CH340". App-specific data shaping
             rather than a theme token, so it lives here and not in Theme.xaml,
             though it draws on the theme's brushes.

             The dropdown grows to fit these: Tpl.ComboBox binds the popup's
             MinWidth - not Width - to the ComboBox, so the list can be wider
             than the 110px control it drops from. -->
        <DataTemplate x:Key="Tpl.PortItem">
            <StackPanel Orientation="Horizontal">
                <!-- No explicit Foreground: it must keep inheriting so the
                     IsEnabled=False trigger in Tpl.ComboBox can grey the closed
                     box while a port is open. See the MultiDataTrigger below. -->
                <TextBlock x:Name="portName" Text="{Binding PortName}"/>
                <!-- Segoe UI, overriding the ComboBox's mono: the port name is
                     data, but the device name is prose (Theme.xaml header -
                     "mono is data-only"). -->
                <TextBlock x:Name="description"
                           Text="{Binding Description}"
                           Margin="12,0,0,0"
                           FontFamily="Segoe UI"
                           Foreground="{StaticResource Brush.MutedStrong}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Not on the USB bus, so not a plausible board: show the bare
                     port name however Windows described it. The description is
                     still carried on the item - the status bar shows it. -->
                <DataTrigger Binding="{Binding IsUsbDevice}" Value="False">
                    <Setter TargetName="description" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <!-- ComboBox reuses ItemTemplate for the closed selection box,
                     where there is no ComboBoxItem ancestor for this binding to
                     find. So the description collapses there and the closed
                     control still reads just "COM3", as it always has - the
                     full text lives in the dropdown and the status bar. -->
                <DataTrigger Value="{x:Null}"
                             Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}">
                    <Setter TargetName="description" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <!-- Let an uninteresting port recede. Recolor rather than
                     opacity-dim, per the rule stated in Tpl.ComboBox.

                     The IsEnabled condition scopes this to dropdown rows only:
                     in the closed selection box the ancestor lookup finds
                     nothing, resolves to null, and the condition fails. That
                     matters - an explicit Foreground here would beat the
                     inherited one and break the disabled (port-open) grey. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsUsbDevice}" Value="False"/>
                        <Condition Value="True"
                                   Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem},
                                                     Path=IsEnabled}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="portName" Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: connection settings -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.BgRaised}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Label Content="COM Port"/>
                    <!-- SelectedValuePath keeps the bound selection a plain port
                         name, so only the list item type gained a description. -->
                    <ComboBox Width="110"
                              ItemsSource="{Binding Ports}"
                              ItemTemplate="{StaticResource Tpl.PortItem}"
                              SelectedValuePath="PortName"
                              SelectedValue="{Binding SelectedPortName}"
                              IsEnabled="{Binding IsConfigEnabled}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="Baud Rate"/>
                    <ComboBox Width="110" IsEditable="True"
                              ItemsSource="{Binding BaudRates}"
                              Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsConfigEnabled}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <Label Content="Parity"/>
                    <ComboBox Width="90"
                              ItemsSource="{Binding ParityOptions}"
                              SelectedItem="{Binding SelectedParity}"
                              IsEnabled="{Binding IsConfigEnabled}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <Label Content="Stop Bits"/>
                    <ComboBox Width="120"
                              ItemsSource="{Binding StopBitsOptions}"
                              SelectedItem="{Binding SelectedStopBits}"
                              IsEnabled="{Binding IsConfigEnabled}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,12,0">
                    <Label Content="Display Data As"/>
                    <!-- Deliberately not bound to IsConfigEnabled: this is a
                         view-formatting choice, not a serial parameter, so it
                         stays live while the port is open. The next chunk read
                         picks up the new mode; text already in the log keeps
                         the format it was rendered with. -->
                    <ComboBox Width="110"
                              ItemsSource="{Binding DisplayDataOptions}"
                              SelectedItem="{Binding SelectedDisplayDataOption}"/>
                </StackPanel>

                <Button Grid.Column="6"
                        Style="{StaticResource Btn.Primary}"
                        Content="{Binding TogglePortButtonText}"
                        Command="{Binding TogglePortCommand}"
                        MinWidth="110"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- Serial log -->
        <RichTextBox Grid.Row="1" Name="RichTextBox_Data"
                     Style="{StaticResource LogBox}"
                     Margin="12,12,12,8">
            <!-- Explicit menu: the default editor context menu bypasses the
                 dark implicit styles, and Cut/Paste are useless in a
                 read-only log. -->
            <RichTextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
                    <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"/>
                    <!-- Bound through PlacementTarget: a ContextMenu sits in its
                         own popup, outside the RichTextBox's visual tree, so a
                         plain {Binding ClearOutputCommand} is not reliable. -->
                    <MenuItem Header="Clear" InputGestureText="Ctrl+K"
                              Command="{Binding PlacementTarget.DataContext.ClearOutputCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </RichTextBox.ContextMenu>
        </RichTextBox>

        <!-- Log actions. A bottom bar, not a header strip above the log: Clear
             is irreversible here (nothing sits behind the document and LogBox
             sets IsUndoEnabled=False), so it is kept the full height of the log
             away from Open Port rather than stacked right underneath it. It is
             also where the eye already is, since the log auto-scrolls to the
             end. Outline, not Primary - one filled orange button per view. -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="12,0,12,10">
            <Button Style="{StaticResource Btn.Outline}"
                    Content="Clear"
                    Command="{Binding ClearOutputCommand}"
                    MinWidth="90"/>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.BgRaised}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <!-- DockPanel, not StackPanel: TextTrimming needs a constrained
                 width to ever show its ellipsis. -->
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8"
                         VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Brush.MutedStrong}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPortOpen}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Brush.SignalOk}"/>
                                    <Setter Property="Effect" Value="{StaticResource Fx.GlowOk}"/>
                                </DataTrigger>
                                <!-- Declared after IsPortOpen so an error wins
                                     when both are true (e.g. a failed close). -->
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Brush.SignalError}"/>
                                    <Setter Property="Effect" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="12"
                           Foreground="{StaticResource Brush.MutedStrong}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
