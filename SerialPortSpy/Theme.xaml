<!--
    Serial Port Spy - Ludic Worlds dark theme.

    Source of truth for colors/tokens: serial-port-spy-style-guide.md (repo root).
    Deliberate deviations from the guide (desktop app, not website):
      - UI chrome stays Segoe UI (no Rubik bundling); mono is data-only.
      - Desktop radii (4 controls / 8 popups) instead of the web 10/16.
      - No eyebrow headers, cards, wordmark gradient, or Cursor=Hand.

    Dictionary order is load-bearing: StaticResource cannot forward-reference,
    so sections are ordered Colors, Brushes, misc resources, FocusVisual,
    part styles, keyed templates, control styles.

    NOTE: There is no dark ToolTip or validation-adorner style here because the
    app defines neither. Add dark styles before introducing either, or they
    will render in the light system theme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================ COLORS ============================ -->
    <Color x:Key="Color.Bg">#FF0F0F0F</Color>
    <Color x:Key="Color.BgRaised">#FF161616</Color>
    <Color x:Key="Color.BgElevated">#FF1C1C1C</Color>
    <Color x:Key="Color.Text">#FFEDEDED</Color>
    <Color x:Key="Color.MutedStrong">#FF9A9A9A</Color>
    <Color x:Key="Color.Muted">#FF7A7A7A</Color>
    <Color x:Key="Color.Border">#FF2A2A2A</Color>
    <Color x:Key="Color.BorderHover">#FF3A3A3A</Color>
    <Color x:Key="Color.ScrollThumb">#FF3A3A3A</Color>
    <Color x:Key="Color.ScrollThumbHover">#FF4A4A4A</Color>

    <Color x:Key="Color.Orange">#FFE85A0A</Color>
    <Color x:Key="Color.OrangeHover">#FFFF6D25</Color>
    <Color x:Key="Color.OrangeActive">#FFFF8F5E</Color>
    <Color x:Key="Color.OrangeLight">#FFFFAA5C</Color>
    <Color x:Key="Color.OnOrange">#FF131313</Color>

    <!-- The alternating log-chunk pair. Both are app-local data colours, NOT
         style-guide brand tokens: YellowLight extends the logo's own hue ramp
         (21 deg darkest to 29 deg lightest) on past its lightest tint - the logo
         contains no yellow at all - and OrangePale is brand OrangeLight softened
         30% toward it, so the two sit closer without merging.

         They are only ~12 deg apart in hue, so they are told apart by LIGHTNESS
         (84% vs 73%). That is worth ~14 dE2000: well past the ~5 needed to read
         as clearly distinct, but gentler than the 19.8 of the original pairing.
         If either is retuned, keep dE2000 comfortably above 10. -->
    <Color x:Key="Color.YellowLight">#FFFFE9AD</Color>
    <Color x:Key="Color.OrangePale">#FFFFBD74</Color>

    <Color x:Key="Color.AccentBlue">#FF5CC8FF</Color>
    <Color x:Key="Color.SignalOk">#FF4ADE80</Color>
    <Color x:Key="Color.SignalError">#FFFF5C5C</Color>

    <!-- ============================ BRUSHES =========================== -->
    <SolidColorBrush x:Key="Brush.Bg"              Color="{StaticResource Color.Bg}"/>
    <SolidColorBrush x:Key="Brush.BgRaised"        Color="{StaticResource Color.BgRaised}"/>
    <SolidColorBrush x:Key="Brush.BgElevated"      Color="{StaticResource Color.BgElevated}"/>
    <SolidColorBrush x:Key="Brush.Text"            Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.MutedStrong"     Color="{StaticResource Color.MutedStrong}"/>
    <SolidColorBrush x:Key="Brush.Muted"           Color="{StaticResource Color.Muted}"/>
    <SolidColorBrush x:Key="Brush.Border"          Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderHover"     Color="{StaticResource Color.BorderHover}"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb"     Color="{StaticResource Color.ScrollThumb}"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{StaticResource Color.ScrollThumbHover}"/>

    <SolidColorBrush x:Key="Brush.Orange"          Color="{StaticResource Color.Orange}"/>
    <SolidColorBrush x:Key="Brush.OrangeHover"     Color="{StaticResource Color.OrangeHover}"/>
    <SolidColorBrush x:Key="Brush.OrangeActive"    Color="{StaticResource Color.OrangeActive}"/>
    <SolidColorBrush x:Key="Brush.OrangeLight"     Color="{StaticResource Color.OrangeLight}"/>
    <SolidColorBrush x:Key="Brush.OnOrange"        Color="{StaticResource Color.OnOrange}"/>
    <SolidColorBrush x:Key="Brush.YellowLight"     Color="{StaticResource Color.YellowLight}"/>
    <SolidColorBrush x:Key="Brush.OrangePale"      Color="{StaticResource Color.OrangePale}"/>

    <!-- Kept for reference: was the second log-chunk colour before the warm
         yellow replaced it. Currently unreferenced. -->
    <SolidColorBrush x:Key="Brush.AccentBlue"      Color="{StaticResource Color.AccentBlue}"/>
    <SolidColorBrush x:Key="Brush.SignalOk"        Color="{StaticResource Color.SignalOk}"/>
    <SolidColorBrush x:Key="Brush.SignalError"     Color="{StaticResource Color.SignalError}"/>

    <!-- Orange at ~13% / ~20% alpha for popup and menu item hover/selection. -->
    <SolidColorBrush x:Key="Brush.ItemHover"       Color="#22E85A0A"/>
    <SolidColorBrush x:Key="Brush.ItemSelected"    Color="#33E85A0A"/>

    <!-- ====================== FONTS / SIZES / RADII =================== -->
    <!-- Mono is for data only (log, combo values, status message); UI chrome
         keeps the WPF default Segoe UI. Cascadia Code ships with Win 11 /
         Terminal / VS; the fallbacks cover older machines. -->
    <FontFamily x:Key="Font.Mono">Cascadia Code, Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="Fs.Log">13</sys:Double>

    <CornerRadius x:Key="Radius.Ctrl">4</CornerRadius>
    <CornerRadius x:Key="Radius.Popup">8</CornerRadius>

    <Geometry x:Key="Geo.Chevron">M 0,0 L 4,4 L 8,0</Geometry>

    <!-- Subtle green glow for the connected status dot. -->
    <DropShadowEffect x:Key="Fx.GlowOk" Color="#FF4ADE80" BlurRadius="8"
                      ShadowDepth="0" Opacity="0.6"/>

    <!-- ========================= FOCUS VISUAL ========================= -->
    <!-- Keyboard-navigation focus ring (Tab/arrows only, per WPF behavior);
         mouse focus is signalled by the in-template orange borders. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource Brush.OrangeActive}"
                               StrokeThickness="2" RadiusX="6" RadiusY="6"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================== PART STYLES ========================= -->

    <!-- Inner TextBox of the editable (baud rate) ComboBox. The explicit
         ContextMenu is required: the built-in editor menu is an internal WPF
         type that bypasses the implicit ContextMenu/MenuItem styles below and
         would render in the light system theme. -->
    <Style x:Key="ComboBoxEditableTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Orange}"/>
        <!-- Translucent wash, NOT an opaque fill: the selection tints the text
             instead of covering it, so you can still read what you are selecting.
             SelectionTextBrush is deliberately unset - relying on it to recolor
             glyphs near-black is fragile, and at this opacity the normal
             foreground stays legible through the tint anyway. -->
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Orange}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="Cut" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"/>
                    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
                    <MenuItem Header="Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.MutedStrong}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Invisible track-paging buttons for the scrollbar (the non-null
         transparent Fill keeps them hit-testable). -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bd" Background="{StaticResource Brush.ScrollThumb}" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ScrollThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ScrollThumbHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================== KEYED TEMPLATES ======================= -->

    <!-- One ComboBox template for both modes: the IsEditable trigger swaps the
         ContentPresenter for PART_EditableTextBox and shrinks the transparent
         toggle to the arrow column so text clicks place the caret instead of
         opening the dropdown. PART_* names are ComboBox contracts. -->
    <ControlTemplate x:Key="Tpl.ComboBox" TargetType="ComboBox">
        <Grid>
            <Border x:Name="bd" Background="{StaticResource Brush.BgElevated}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Ctrl}" SnapsToDevicePixels="True"/>
            <Grid Margin="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="toggle" Grid.Column="0" Grid.ColumnSpan="2"
                              Focusable="False" ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="content" Grid.Column="0" Margin="10,0,0,0"
                                  VerticalAlignment="Center" IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="10,0,0,0"
                         VerticalContentAlignment="Center" Visibility="Collapsed"
                         Style="{StaticResource ComboBoxEditableTextBox}"/>
                <Path x:Name="arrow" Grid.Column="1" Data="{StaticResource Geo.Chevron}"
                      Stroke="{StaticResource Brush.MutedStrong}" StrokeThickness="1.5"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False"/>
            </Grid>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                   Focusable="False">
                <Border x:Name="dropDown" Background="{StaticResource Brush.BgElevated}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Popup}" Padding="0,4"
                        Margin="0,4,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ScrollViewer>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                <Setter TargetName="content" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="toggle" Property="Grid.Column" Value="1"/>
                <Setter TargetName="toggle" Property="Grid.ColumnSpan" Value="1"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Orange}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Orange}"/>
            </Trigger>
            <!-- Port open: recolor, don't opacity-dim - port/baud values stay
                 readable while monitoring (style guide principle 4). -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.BgRaised}"/>
                <Setter TargetName="content" Property="TextElement.Foreground" Value="{StaticResource Brush.MutedStrong}"/>
                <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource Brush.Muted}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Tpl.VScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="2,0"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Tpl.HScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}" Margin="0,2"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- ======================== CONTROL STYLES ======================== -->

    <!-- Combo values render in mono deliberately: port/baud/parity/stop-bit
         values are data (style guide, typography section). -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template" Value="{StaticResource Tpl.ComboBox}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Margin="4,1"
                            CornerRadius="{StaticResource Radius.Ctrl}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsHighlighted after IsSelected so hover reads over a
                             selected item; foreground stays Text on both tints. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ItemSelected}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ItemHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal modern scrollbar: no arrow buttons, transparent track, rounded
         thumb. Implicit so it also reaches the combo popup's scroll viewer. -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template" Value="{StaticResource Tpl.VScrollBar}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <!-- Width must be reset or a 10px-wide horizontal bar results. -->
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template" Value="{StaticResource Tpl.HScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Field labels above the toolbar combos. -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource Brush.MutedStrong}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0,0,0,4"/>
    </Style>

    <!-- Dark context menu. Handles top-level items only (no icons, checks, or
         submenus) - extend the MenuItem template before adding any of those. -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Brush.BgElevated}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Popup}" Padding="4"
                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" Padding="10,6"
                            CornerRadius="{StaticResource Radius.Ctrl}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{StaticResource Brush.Muted}" Margin="24,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ItemHover}"/>
                        </Trigger>
                        <!-- MutedStrong, not Muted: a disabled item's label must
                             still be readable (e.g. Copy with no selection). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.MutedStrong}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one primary action (Open/Close Port). Keyed on purpose: the brand
         allows exactly one orange button per view. Text is near-black OnOrange
         in every state - never white on orange (fails WCAG AA). -->
    <Style x:Key="Btn.Primary" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Orange}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.OnOrange}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Ctrl}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsPressed after IsMouseOver so it wins while both are true. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.OrangeHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.OrangeActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The serial log. Retemplated because the default TextBoxBase template
         hardcodes light-blue hover/focus borders that recoloring can't remove.
         Selection is a translucent orange wash (see ComboBoxEditableTextBox):
         an opaque fill would hide the data being selected, and leaving
         SelectionTextBrush unset means the alternating blue/orange chunk colours
         survive selection instead of being flattened to one colour. -->
    <Style x:Key="LogBox" TargetType="RichTextBox">
        <Setter Property="Background" Value="{StaticResource Brush.BgElevated}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="{StaticResource Fs.Log}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsUndoEnabled" Value="False"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Orange}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RichTextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Ctrl}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Orange}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
